{
  "name": "johnny",
  "version": "0.1.0",
  "description": "Local agentic memory librarian for Claude Code. Johnny Neuromorphic by Positronik.",
  "type": "module",
  "bin": {
    "johnny": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "generate:tokens": "npm run build && node dist/brand/tokens-css.js",
    "link": "npm run build && npm link"
  },
  "keywords": [
    "claude",
    "claude-code",
    "memory",
    "context",
    "mcp",
    "sqlite",
    "ollama",
    "local-first"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "chalk-animation": "^2.0.3",
    "figlet": "^1.7.0",
    "gradient-string": "^3.0.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.4.5",
    "vitest": "^4.1.12"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "author": "Brad Litwin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr4ntiVirus/johnny.git"
  },
  "homepage": "https://github.com/Mr4ntiVirus/johnny#readme",
  "bugs": {
    "url": "https://github.com/Mr4ntiVirus/johnny/issues"
  }
}
